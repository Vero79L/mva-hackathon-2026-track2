# shellcheck shell=bash
# Track 2 第一階段（Spec 1 v1.1）的路徑設定。這個 .example 進 git；複製成 config/local.env（不進 git）再改：
#   cp config/local.env.example config/local.env
# 寫法和 Track 1 一樣：: "${變數:=值}" 只在變數沒設定時才給值，所以執行前 export 的同名變數優先。

# 1) 先沿用 Track 1 的設定：參考資源（RES、REF、GTF、VEP_CACHE、VEP_VERSION、CLINVAR…）只在 Track 1 改一處。
#    Track 1 的 local.env 目前把 RES 指到外接碟 /Volumes/DISK-2/…，這裡會自動跟著。
: "${T1_CONF:=$HOME/mva-hackathon/repo/track1/config}"
if [ -f "$T1_CONF/local.env" ]; then . "$T1_CONF/local.env"; fi
. "$T1_CONF/paths.env"

# 2) Track 1 的輸入（第 10、11、15 步讀）
: "${T1_WORK:=$WORK}"                          # norm.vcf.gz（含基因型）
: "${T1_RESULTS:=$RESULTS}"                    # 提交 CSV、run_manifest.tsv、hpo_terms.tsv

# 3) Track 2 第一階段的輸出
: "${T2_RESULTS:=$MVA_ROOT/results/track2}"    # 含座標：交接檔、transcript_facts.yaml、VEP 輸出、log。不進 git、不在 iCloud 樹
: "${T2_WORK:=$MVA_ROOT/work/track2}"          # 公開資料快取（UniProt、AlphaFold、文獻）、ClinVar 自我檢查
# : "${REGISTERS:=/Users/<你>/…/mva/research/registers}"   # 預設 = engine 的上一層的 registers/，通常不用改

# 4) 這個病例
: "${CASE_ID:=bub1b_mva}"                      # config/cases/<CASE_ID>.yaml
: "${GENE:=}"                                  # 空白 = 由 Track 1 提交檔第 1 列的 notes 決定（第 10 步）
: "${VEP_DISTANCE:=100000}"                    # 基因上下游幾 bp 內仍標 upstream / downstream（上游的調控變異需要）
: "${CROSSREF_MAILTO:=}"                       # 選填：Crossref 禮貌池用的 email（第 16 步）
